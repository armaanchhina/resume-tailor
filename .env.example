# Copy this file to .env (for `prisma` CLI commands run on the host) and/or
# .env.docker (used by the app container via docker-compose) and fill in
# real values. Never commit the filled-in versions.

# Postgres connection string.
# - For `.env` (host-side prisma commands): postgresql://docker:docker@localhost:5432/resume-tailor
# - For `.env.docker` (app container, talks to the `postgres` service by name):
# - In production (Render/Railway/Fly/Neon/etc.), use the connection string your provider
#   gives you -- it usually needs `?sslmode=require` appended for external connections.
DATABASE_URL="postgresql://docker:docker@postgres:5432/resume-tailor"

# OpenAI API key used for resume/cover-letter tailoring. Get one at
# https://platform.openai.com/api-keys
# If you're reading this after cloning a repo that once had a real key committed or sitting in
# a local env file, rotate it -- don't assume an old key is still safe to reuse.
OPENAI_API_KEY="sk-..."

# Set to "production" when deploying. Affects the session cookie's Secure flag (only sent over
# HTTPS) and a few other Next.js production behaviors. Most Docker-native hosts (Render,
# Railway, Fly) set this for you when they detect a Dockerfile build -- confirm it's actually
# set rather than assuming so.
NODE_ENV="development"
